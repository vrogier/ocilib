CC = g++
CFLAGS =  -Wall -D@OCILIB_CHARSET@ -DOCI_IMPORT_LINKAGE
EXEC_NAME = ocilib_tests
INCLUDES = -I/usr/local/include -I@OCILIB_PREFIX@/include @ORACLE_INCLUDES@
# the tests exercise internal (OCI_SYM_LOCAL, visibility-hidden) symbols, so
# they must link the static archive — the shared lib does not export them.
# libocilib.a must precede @ORACLE_LIBADD@: in linkage mode it takes the
# address of every OCI entry point, and with ld --as-needed a clntsh listed
# first would be discarded before those references appear.
LIBS = @OCILIB_PREFIX@/lib/libocilib.a @ORACLE_LIBADD@ -lgtest -lgtest_main -lpthread
SOURCES := $(wildcard *.cpp) 
OBJS := $(addsuffix .o, $(basename $(notdir $(SOURCES))))

all: $(EXEC_NAME)
    
$(EXEC_NAME): $(OBJS)
	$(CC) -o $(EXEC_NAME) $(OBJS) $(LIBS)

%.o: %.cpp
	$(CC) $(CFLAGS) $(INCLUDES) -o $@ -c $<

%.o: %.c
	$(CC) $(CFLAGS) $(INCLUDES) -o $@ -c $<

clean: 
	rm -f *~ $(EXEC_NAME) 
	rm -f *~ $(OBJS)

